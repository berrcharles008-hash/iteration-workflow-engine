      "stages": ["01", "03"],
      "signals": { "terms": ["复杂度", "工作量", "预估", "人日", "评分"] }
    },
    {
      "id": "capability-map",
      "title": "能力盘点与复用清单",
      "file": "capability-map.md",
      "stages": ["01", "03"],
      "signals": { "terms": ["能力", "复用", "模块", "清单", "盘点"] }
    },
    {
      "id": "evolution-safety",
      "title": "引擎自改安全纪律（仅改引擎时）",
      "file": "evolution-safety.md",
      "stages": ["01", "02", "03", "04", "05", "06", "07"],
      "signals": { "terms": ["引擎", "skill", "门禁", "工作流改造", "工作流引擎"] }
    },
    {
      "id": "lessons",
      "title": "经验教训沉淀",
      "file": "lessons-learned.md",
      "stages": ["01", "07"],
      "signals": { "terms": ["回顾", "复盘", "经验", "教训", "沉淀"] }
    },
    {
      "id": "workflow-engine",
      "title": "工作流引擎总览",
      "file": "workflow-engine.md",
      "stages": ["01", "03", "07"],
      "signals": { "terms": ["工作流", "阶段流转", "流程改造"] }
    }
  ]
